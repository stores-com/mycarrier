{
    "dependencies": {
        "@stores.com/http-error": "~1.2.0"
    },
    "description": "A Node.js client for MyCarrier LTL freight rates and shipping locations.",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.10.0",
        "globals": "^17.12.0"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "freight",
        "logistics",
        "ltl",
        "mycarrier",
        "shipping"
    ],
    "license": "MIT",
    "name": "my-carrier",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stores-com/my-carrier.git"
    },
    "scripts": {
        "test": "node --test --test-reporter=spec test/*.js",
        "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec test/*.js",
        "test:only": "node --test --test-only --test-reporter=spec test/*.js"
    },
    "version": "0.0.1"
