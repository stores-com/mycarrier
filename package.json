{
    "dependencies": {
        "@stores.com/http-error": "~1.2.0"
    },
    "description": "A Node.js client for MyCarrier LTL freight rates, shipping locations, and shipment details.",
    "devDependencies": {
        "@eslint/js": "*",
        "eslint": "*",
        "globals": "*"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "freight",
        "logistics",
        "ltl",
        "mycarrier",
        "shipping"
    ],
    "license": "MIT",
    "name": "mycarrier",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stores-com/mycarrier.git"
    },
    "scripts": {
        "test": "node --test --test-reporter=spec test/*.js",
        "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec test/*.js",
        "test:only": "node --test --test-only --test-reporter=spec test/*.js"
    },
    "version": "0.0.1"
}
